{{ 'zay-sections.css' | asset_url | stylesheet_tag }}

<section class="zay-section path-cards color-{{ section.settings.color_scheme }}">
  <div class="zay-container">
    {%- if section.settings.heading != blank -%}
      <div class="zay-section__head">
        <h2 class="zay-section__heading">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="path-cards__grid" data-count="{{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        {%- if block.type == 'path' -%}
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="path-card"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.eyebrow != blank -%}
              <p class="zay-eyebrow path-card__eyebrow">{{ block.settings.eyebrow }}</p>
            {%- endif -%}
            <h3 class="path-card__title">{{ block.settings.title }}</h3>
            {%- if block.settings.copy != blank -%}
              <p class="path-card__copy">{{ block.settings.copy }}</p>
            {%- endif -%}
            <span class="path-card__link">
              {{ block.settings.link_text | default: 'Learn more' }}
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Path cards",
  "class": "section-path-cards",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Midnight" },
        { "value": "scheme-2", "label": "Charcoal" },
        { "value": "scheme-4", "label": "Charcoal (warm)" }
      ],
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Two ways to work with Brandon"
    }
  ],
  "blocks": [
    {
      "type": "path",
      "name": "Path",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "title", "label": "Title", "default": "Request or Reserve a Piece" },
        { "type": "textarea", "id": "copy", "label": "Copy" },
        { "type": "text", "id": "link_text", "label": "Link text", "default": "Start a request" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Path cards",
      "blocks": [
        {
          "type": "path",
          "settings": {
            "eyebrow": "Sourced & High-Value",
            "title": "Request or Reserve a Piece",
            "copy": "Tell Brandon what you're after. Most serious pieces move by private request, not checkout.",
            "link_text": "Start a request"
          }
        },
        {
          "type": "path",
          "settings": {
            "eyebrow": "Direct & Discreet",
            "title": "Book a Call with Brandon",
            "copy": "High-value pieces close by phone and wire. Get on the calendar directly.",
            "link_text": "Book a call"
          }
        },
        {
          "type": "path",
          "settings": {
            "eyebrow": "Ready Now",
            "title": "Shop In-Stock",
            "copy": "Available pieces, ready to ship fully insured.",
            "link_text": "Browse in-stock"
          }
        }
      ]
    }
  ]
}
{% endschema %}
