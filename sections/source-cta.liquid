{{ 'zay-sections.css' | asset_url | stylesheet_tag }}

<section class="zay-section source-cta color-{{ section.settings.color_scheme }}">
  <div class="zay-container">
    <div class="source-cta__inner">
      {%- if section.settings.eyebrow != blank -%}
        <p class="zay-eyebrow source-cta__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="source-cta__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <p class="source-cta__body">{{ section.settings.body }}</p>
      {%- endif -%}
      {%- if section.settings.cta_text != blank -%}
        <a href="{{ section.settings.cta_link | default: '#' }}" class="button button--primary source-cta__button">
          {{ section.settings.cta_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{%- style -%}
  .source-cta__inner {
    max-width: 40rem;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--zay-space-2, 1rem);
  }

  .source-cta__eyebrow {
    margin: 0;
  }

  .source-cta__heading {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight, 600);
    font-size: var(--zay-text-3xl);
    line-height: 1.1;
    color: var(--zay-ink, #f4f1ea);
  }

  .source-cta__body {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: var(--zay-text-lg);
    line-height: 1.7;
    color: var(--zay-ink-muted, #a8a29b);
  }

  .source-cta__button {
    margin-top: var(--zay-space-3, 1.5rem);
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Source CTA",
  "class": "section-source-cta",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Studio dark" },
        { "value": "scheme-2", "label": "Studio dark (elevated)" },
        { "value": "scheme-3", "label": "Card surface" }
      ],
      "default": "scheme-2"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "No Speculative Inventory"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every piece is sourced, not simply shelved."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Zaeed Jewelers doesn't stock watches hoping the right buyer finds them. Tell Brandon what you're looking for, and he sources it through a trusted dealer network — authenticated, insured, and delivered discreetly."
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button label",
      "default": "Inquire About Sourcing a Piece"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Source CTA"
    }
  ]
}
{% endschema %}
