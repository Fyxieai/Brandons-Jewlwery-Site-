{% comment %}
  Hero — Scroll-Scrubbed Image Sequence (v2 — integrated two-column layout)
  Self-contained section: inline CSS + inline JS (GSAP/ScrollTrigger via CDN),
  drop-in ready. Preloads a numbered frame sequence from theme assets and maps
  scroll position to frame index. Unlike v1 (full-bleed background wash),
  the sequence lives in a framed left column paired with a right content
  column and a live stage indicator driven by the same scroll progress — the
  piece reads as an interactive module, not decorative wallpaper.

  Frames expected at: assets/{{ section.settings.frame_prefix }}NNN.jpg
  (3-digit zero-padded, 1-indexed). Source composition note: the piece sits
  in the right ~40% of each source frame with dark negative space on the
  left — the canvas draw uses a right-biased crop (not centered) so that
  empty space is what gets cropped away, not the piece itself.
{% endcomment %}

{%- assign frame_count = section.settings.frame_count -%}
{%- assign frame_prefix = section.settings.frame_prefix -%}

<section
  class="hss color-{{ section.settings.color_scheme }}"
  id="hss-{{ section.id }}"
  data-hss
  data-frame-count="{{ frame_count }}"
  style="--hss-track-vh: {{ section.settings.scroll_length }};"
>
  <div class="hss__track">
    <div class="hss__pin">
      <div class="hss__grid">
        <div class="hss__media">
          <div class="hss__media-frame">
            <canvas class="hss__canvas" data-hss-canvas aria-hidden="true"></canvas>
          </div>

          <ol class="hss__stages" data-hss-stages>
            {%- for block in section.blocks -%}
              {%- if block.type == 'stage' -%}
                <li class="hss__stage" data-hss-stage data-threshold="{{ block.settings.threshold }}">
                  <span class="hss__stage-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                  <span class="hss__stage-label">{{ block.settings.label }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ol>
        </div>

        <div class="hss__content">
          {%- if section.settings.eyebrow != blank -%}
            <p class="zay-eyebrow hss__eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h1 class="hss__heading">{{ section.settings.heading }}</h1>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="hss__subheading">{{ section.settings.subheading }}</p>
          {%- endif -%}
          <div class="hss__actions">
            {%- if section.settings.primary_cta_text != blank -%}
              <a href="{{ section.settings.primary_cta_link | default: '#' }}" class="button button--primary">
                {{ section.settings.primary_cta_text }}
              </a>
            {%- endif -%}
            {%- if section.settings.secondary_cta_text != blank -%}
              <a href="{{ section.settings.secondary_cta_link | default: '#' }}" class="button button--secondary">
                {{ section.settings.secondary_cta_text }}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>

      <div class="hss__scroll-cue" data-hss-cue aria-hidden="true">
        <span></span>
        <p>Scroll</p>
      </div>
    </div>

    <div class="hss__loader" data-hss-loader role="status" aria-live="polite">
      <div class="hss__loader-mark">
        <svg viewBox="0 0 200 200" fill="none" aria-hidden="true">
          <circle cx="100" cy="100" r="72" stroke="currentColor" stroke-width="1.25"/>
          <line x1="100" y1="100" x2="100" y2="58" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
          <line x1="100" y1="100" x2="128" y2="112" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
        </svg>
      </div>
      <div class="hss__loader-bar">
        <div class="hss__loader-fill" data-hss-loader-fill></div>
      </div>
      <p class="hss__loader-label" data-hss-loader-label>Loading 0%</p>
    </div>
  </div>
</section>

{%- style -%}
  .hss {
    position: relative;
    background: rgb(var(--color-background));
  }

  .hss__track {
    position: relative;
    height: calc(var(--hss-track-vh, 500) * 1vh);
  }

  .hss__pin {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    overflow: hidden;
    display: flex;
    align-items: center;
    opacity: 0;
    transition: opacity 400ms ease;
  }

  .hss[data-hss-ready] .hss__pin {
    opacity: 1;
  }

  .hss__grid {
    width: 100%;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: var(--zay-space-8, 4rem);
    max-width: var(--zay-container-max);
    margin-inline: auto;
    padding-inline: var(--zay-space-6, 3rem);
  }

  .hss__media {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--zay-space-4, 2rem);
  }

  .hss__media-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    max-height: 76vh;
    border: 1px solid var(--zay-hairline, rgba(244, 241, 234, 0.12));
    background: rgb(var(--color-background));
    overflow: hidden;
  }

  .hss__canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  .hss__stages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: var(--zay-space-4, 2rem);
  }

  .hss__stage {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    opacity: 0.4;
    transition: opacity var(--zay-duration-base, 400ms) var(--zay-ease);
  }

  .hss__stage[data-hss-active] {
    opacity: 1;
  }

  .hss__stage-index {
    font-family: var(--font-body-family);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--zay-gold, #c9a45c);
  }

  .hss__stage-label {
    font-family: var(--font-body-family);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--zay-ink, #f4f1ea);
    white-space: nowrap;
  }

  .hss__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    gap: var(--zay-space-2, 1rem);
  }

  .hss__eyebrow {
    margin: 0;
  }

  .hss__heading {
    margin: 0;
    font-family: var(--font-heading-family);
    font-weight: var(--font-heading-weight, 600);
    font-size: var(--zay-text-hero);
    line-height: 1.02;
    color: var(--zay-ink, #f4f1ea);
  }

  .hss__subheading {
    margin: 0;
    max-width: 30rem;
    font-family: var(--font-body-family);
    font-size: var(--zay-text-lg);
    line-height: 1.6;
    color: var(--zay-ink-muted, #a8a29b);
  }

  .hss__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--zay-space-2, 1rem);
    margin-top: var(--zay-space-3, 1.5rem);
  }

  .hss__scroll-cue {
    position: absolute;
    left: var(--zay-space-6, 3rem);
    bottom: var(--zay-space-3, 1.5rem);
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    transition: opacity 200ms linear;
  }

  .hss__scroll-cue span {
    width: 1px;
    height: 2.25rem;
    background: linear-gradient(to bottom, var(--zay-gold, #c9a45c), transparent);
  }

  .hss__scroll-cue p {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--zay-ink-muted, #a8a29b);
  }

  .hss__loader {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--zay-space-3, 1.5rem);
    background: rgb(var(--color-background));
    transition: opacity 500ms ease;
  }

  .hss[data-hss-ready] .hss__loader {
    opacity: 0;
    pointer-events: none;
    position: absolute;
  }

  .hss__loader-mark {
    width: 3rem;
    height: 3rem;
    color: var(--zay-gold, #c9a45c);
    animation: hss-loader-spin 2.4s linear infinite;
  }

  @keyframes hss-loader-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .hss__loader-bar {
    width: min(220px, 60vw);
    height: 1px;
    background: var(--zay-hairline-strong, rgba(244, 241, 234, 0.22));
    overflow: hidden;
  }

  .hss__loader-fill {
    height: 100%;
    width: 0%;
    background: var(--zay-gold, #c9a45c);
    transition: width 120ms linear;
  }

  .hss__loader-label {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: var(--zay-text-sm);
    letter-spacing: 0.08em;
    color: var(--zay-ink-muted, #a8a29b);
  }

  @media (max-width: 989px) {
    .hss__grid {
      grid-template-columns: 1fr;
      grid-template-areas: 'media' 'content';
      gap: var(--zay-space-4, 2rem);
      padding-inline: var(--zay-space-3, 1.5rem);
    }
    .hss__media {
      grid-area: media;
    }
    .hss__content {
      grid-area: content;
    }
    .hss__media-frame {
      aspect-ratio: 1 / 1;
      max-height: 46vh;
    }
    .hss__heading {
      font-size: clamp(2.25rem, 1.2rem + 5vw, 3.5rem);
    }
    .hss__stages {
      gap: var(--zay-space-2, 1rem);
      flex-wrap: wrap;
    }
    .hss__scroll-cue {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hss__track {
      height: 100vh;
      height: 100dvh;
    }
    .hss__pin {
      position: relative;
    }
  }
{%- endstyle -%}

<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" data-hss-gsap defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" data-hss-scrolltrigger defer></script>

<script>
  (function () {
    var sectionId = {{ section.id | json }};
    var frameCount = {{ frame_count | json }};
    var frameUrls = [
      {%- for i in (1..frame_count) -%}
        {%- assign padded = i | prepend: '0000' | slice: -3, 3 -%}
        {%- assign filename = frame_prefix | append: padded | append: '.jpg' -%}
        {{ filename | asset_url | json }}{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ];

    function boot() {
      var root = document.getElementById('hss-' + sectionId);
      if (!root) return;

      var canvas = root.querySelector('[data-hss-canvas]');
      var loaderFill = root.querySelector('[data-hss-loader-fill]');
      var loaderLabel = root.querySelector('[data-hss-loader-label]');
      var track = root.querySelector('.hss__track');
      var cue = root.querySelector('[data-hss-cue]');
      var stageEls = Array.prototype.slice.call(root.querySelectorAll('[data-hss-stage]'));
      var ctx = canvas.getContext('2d');

      var images = new Array(frameCount);
      var loadedCount = 0;
      var currentFrame = 0;
      var naturalW = 0;
      var naturalH = 0;
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var HORIZONTAL_BIAS = 0.78; // 0 = show source's left edge, 1 = show source's right edge.
      // The source frames compose the piece in the right ~40% of the image
      // with empty space on the left — biasing the cover-crop right means
      // that empty space is what gets cropped away, not the piece.

      function sizeCanvas() {
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var rect = canvas.parentElement.getBoundingClientRect();
        canvas.width = Math.round(rect.width * dpr);
        canvas.height = Math.round(rect.height * dpr);
        canvas.style.width = rect.width + 'px';
        canvas.style.height = rect.height + 'px';
      }

      function drawFrame(index) {
        var img = images[index];
        if (!img || !img.complete || !naturalW) return;
        var cw = canvas.width;
        var ch = canvas.height;
        var scale = Math.max(cw / naturalW, ch / naturalH);
        var dw = naturalW * scale;
        var dh = naturalH * scale;
        var dx = (cw - dw) * HORIZONTAL_BIAS;
        var dy = (ch - dh) / 2;
        ctx.clearRect(0, 0, cw, ch);
        ctx.drawImage(img, dx, dy, dw, dh);
      }

      function updateProgress() {
        var pct = Math.round((loadedCount / frameCount) * 100);
        if (loaderFill) loaderFill.style.width = pct + '%';
        if (loaderLabel) loaderLabel.textContent = 'Loading ' + pct + '%';
      }

      function updateStages(progress) {
        if (!stageEls.length) return;
        var activeIndex = 0;
        for (var i = 0; i < stageEls.length; i++) {
          var threshold = parseFloat(stageEls[i].getAttribute('data-threshold')) || 0;
          if (progress >= threshold) activeIndex = i;
        }
        stageEls.forEach(function (el, i) {
          if (i === activeIndex) {
            el.setAttribute('data-hss-active', '');
          } else {
            el.removeAttribute('data-hss-active');
          }
        });
      }

      function onAllLoaded() {
        root.setAttribute('data-hss-ready', '');
        sizeCanvas();
        drawFrame(0);
        updateStages(0);
        setupScroll();
      }

      function preload() {
        frameUrls.forEach(function (url, i) {
          var img = new Image();
          img.onload = function () {
            loadedCount++;
            if (i === 0) {
              naturalW = img.naturalWidth;
              naturalH = img.naturalHeight;
              sizeCanvas();
              drawFrame(0);
            }
            updateProgress();
            if (loadedCount === frameCount) onAllLoaded();
          };
          img.onerror = function () {
            loadedCount++;
            if (loadedCount === frameCount) onAllLoaded();
          };
          img.src = url;
          images[i] = img;
        });
      }

      function setupScroll() {
        if (reduceMotion || typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
          if (cue) cue.style.display = 'none';
          return;
        }
        gsap.registerPlugin(ScrollTrigger);

        var state = { frame: 0 };
        gsap.to(state, {
          frame: frameCount - 1,
          ease: 'none',
          scrollTrigger: {
            trigger: track,
            start: 'top top',
            end: 'bottom bottom',
            scrub: 0.35,
            onUpdate: function (self) {
              if (cue) cue.style.opacity = String(Math.max(0, 1 - self.progress * 6));
              updateStages(self.progress);
            }
          },
          onUpdate: function () {
            var idx = Math.round(state.frame);
            if (idx !== currentFrame) {
              currentFrame = idx;
              drawFrame(idx);
            }
          }
        });
      }

      var resizeRaf = null;
      window.addEventListener('resize', function () {
        if (resizeRaf) cancelAnimationFrame(resizeRaf);
        resizeRaf = requestAnimationFrame(function () {
          sizeCanvas();
          drawFrame(currentFrame);
          if (typeof ScrollTrigger !== 'undefined') ScrollTrigger.refresh();
        });
      });

      preload();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot);
    } else {
      boot();
    }
  })();
</script>

{% schema %}
{
  "name": "Hero — Scroll Sequence",
  "class": "section-hero-scroll-sequence",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Studio dark" },
        { "value": "scheme-2", "label": "Studio dark (elevated)" },
        { "value": "scheme-3", "label": "Card surface" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "frame_prefix",
      "label": "Frame filename prefix",
      "default": "daytona-dark-frame-",
      "info": "Frames must exist in theme assets as <prefix>NNN.jpg, 3-digit zero-padded."
    },
    {
      "type": "range",
      "id": "frame_count",
      "label": "Frame count",
      "min": 12,
      "max": 240,
      "step": 4,
      "default": 192
    },
    {
      "type": "range",
      "id": "scroll_length",
      "label": "Scroll length (vh)",
      "min": 200,
      "max": 800,
      "step": 50,
      "default": 500
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Daytona, Reimagined"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every piece, considered."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A gold Rolex Daytona with a meteorite dial — sourced, authenticated, and presented the way it deserves."
    },
    {
      "type": "header",
      "content": "Primary action"
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Button label",
      "default": "Request or Reserve"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Secondary action"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Button label",
      "default": "Book a Call with Brandon"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Button link"
    }
  ],
  "blocks": [
    {
      "type": "stage",
      "name": "Stage",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "The Piece"
        },
        {
          "type": "range",
          "id": "threshold",
          "label": "Activates at scroll progress",
          "min": 0,
          "max": 100,
          "step": 2,
          "default": 0,
          "info": "0-100, as a percent of this section's scroll distance."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero — Scroll Sequence",
      "blocks": [
        { "type": "stage", "settings": { "label": "The Complete Piece", "threshold": 0 } },
        { "type": "stage", "settings": { "label": "The Case Opens", "threshold": 24 } },
        { "type": "stage", "settings": { "label": "The Dial & Hands", "threshold": 54 } },
        { "type": "stage", "settings": { "label": "The Movement", "threshold": 80 } }
      ]
    }
  ]
}
{% endschema %}
